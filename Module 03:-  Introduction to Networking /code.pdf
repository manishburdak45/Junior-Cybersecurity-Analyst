    const aclData = [
      [
        { text: "#", options: { bold: true, color: C.white, fill: { color: C.blue } } },
        { text: "ACTION", options: { bold: true, color: C.white, fill: { color: C.blue } } },
        { text: "SOURCE", options: { bold: true, color: C.white, fill: { color: C.blue } } },
        { text: "DESTINATION", options: { bold: true, color: C.white, fill: { color: C.blue } } },
        { text: "PORT/PROTO", options: { bold: true, color: C.white, fill: { color: C.blue } } },
        { text: "REASON", options: { bold: true, color: C.white, fill: { color: C.blue } } },
      ],
      ["10", { text: "PERMIT", options: { color: C.green, fill: { color: C.panel2 } } }, "192.168.40.0/28", "192.168.20.0/24", "TCP 9100", { text: "Allow print jobs from workstations", options: { color: C.gray, fill: { color: C.panel2 } } }],
      ["20", { text: "PERMIT", options: { color: C.green, fill: { color: C.panel } } }, "192.168.40.0/28", "192.168.30.5", "TCP 25", { text: "Allow printer→mail server for scan-to-email", options: { color: C.gray, fill: { color: C.panel } } }],
      ["30", { text: "DENY", options: { bold: true, color: C.red, fill: { color: C.panel2 } } }, "192.168.40.0/28", "0.0.0.0/0", "TCP 445", { text: "Block SMB — prevent NTLMv2 capture!", options: { color: C.red, fill: { color: C.panel2 } } }],
      ["40", { text: "DENY", options: { bold: true, color: C.red, fill: { color: C.panel } } }, "192.168.40.0/28", "0.0.0.0/0", "ALL", { text: "Block all other internet access", options: { color: C.red, fill: { color: C.panel } } }],
      ["50", { text: "DENY", options: { bold: true, color: C.red, fill: { color: C.panel2 } } }, "192.168.40.0/28", "192.168.30.0/25", "ALL", { text: "Printer cannot reach server segment", options: { color: C.red, fill: { color: C.panel2 } } }],
    ];
    s.addTable(aclData, {
