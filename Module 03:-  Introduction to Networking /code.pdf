    s.addText("MODULE 01  |  NETWORKING OVERVIEW", { x: 0.3, y: 0, w: 6, h: 0.6, fontSize: 9, color: C.gray, fontFace: "Consolas", valign: "middle", charSpacing: 2, margin: 0 });
    s.addText("SLIDE 06 / 14", { x: 7, y: 0, w: 2.7, h: 0.6, fontSize: 9, color: C.cyan, fontFace: "Consolas", align: "right", valign: "middle", charSpacing: 2, margin: 0 });

    s.addText("Subnetting: /24 vs /25 — The Pentester's Pitfall", {
      x: 0.3, y: 0.75, w: 9.4, h: 0.5,
