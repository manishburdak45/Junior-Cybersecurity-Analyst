      s.addText(c.title, { x: xp + 0.6, y: yp + 0.08, w: 3.9, h: 0.3, fontSize: 12, color: c.color, fontFace: "Consolas", bold: true, margin: 0 });
      s.addText(c.subnet, { x: xp + 0.6, y: yp + 0.38, w: 3.9, h: 0.22, fontSize: 8, color: C.gray, fontFace: "Consolas", margin: 0 });
      s.addShape(pres.shapes.LINE, { x: xp + 0.12, y: yp + 0.65, w: 4.35, h: 0, line: { color: C.gray3, width: 0.5 } });
      s.addText(c.desc, { x: xp + 0.12, y: yp + 0.72, w: 4.35, h: 0.7, fontSize: 9, color: C.white, fontFace: "Calibri", margin: 0 });
      s.addShape(pres.shapes.RECTANGLE, { x: xp + 0.12, y: yp + 1.52, w: 4.35, h: 0.28, fill: { color: "1A0808" }, line: { color: C.red, width: 0.5 } });
      s.addImage({ data: iconWarn, x: xp + 0.14, y: yp + 1.56, w: 0.2, h: 0.2 });
      s.addText("ATTACK VECTOR: " + c.threat, { x: xp + 0.38, y: yp + 1.52, w: 4.0, h: 0.28, fontSize: 8, color: C.red, fontFace: "Consolas", valign: "middle", margin: 0 });
    });
