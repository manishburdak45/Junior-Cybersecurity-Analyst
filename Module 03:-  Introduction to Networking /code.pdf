        { text: "10.20.0.200", options: { color: C.cyan, fontFace: "Consolas", fill: { color: C.panel } } },
        { text: "/25", options: { color: C.orange, fill: { color: C.panel } } },
        { text: "10.20.0.128–255  (second half)", options: { color: C.gray, fontFace: "Consolas", fill: { color: C.panel } } },
        { text: "YES", options: { color: C.green, fill: { color: C.panel } } }
      ],
      [
        { text: "PENTESTER (WRONG!)", options: { bold: true, color: C.red, fill: { color: "200A0A" } } },
        { text: "10.20.0.252", options: { color: C.red, fontFace: "Consolas", fill: { color: "200A0A" } } },
        { text: "/24 ← WRONG", options: { bold: true, color: C.red, fill: { color: "200A0A" } } },
        { text: "Assumed full /24 range", options: { color: C.orange, fill: { color: "200A0A" } } },
        { text: "MISSED DC!", options: { bold: true, color: C.red, fill: { color: "200A0A" } } }
