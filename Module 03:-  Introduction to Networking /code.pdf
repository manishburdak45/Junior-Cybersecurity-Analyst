  // ─────────────────────────────────────────────────────────────────
  // SLIDE 7 — NETWORK SEGMENTATION & DEFENSE IN DEPTH
  // ─────────────────────────────────────────────────────────────────
  {
    const s = pres.addSlide();
    s.background = { color: C.bg };

    s.addShape(pres.shapes.RECTANGLE, { x: 0, y: 0, w: 10, h: 0.6, fill: { color: C.panel }, line: { color: C.panel, width: 0 } });
    s.addShape(pres.shapes.RECTANGLE, { x: 0, y: 0.6, w: 10, h: 0.04, fill: { color: C.cyan }, line: { color: C.cyan, width: 0 } });
    s.addText("MODULE 01  |  NETWORKING OVERVIEW", { x: 0.3, y: 0, w: 6, h: 0.6, fontSize: 9, color: C.gray, fontFace: "Consolas", valign: "middle", charSpacing: 2, margin: 0 });
    s.addText("SLIDE 07 / 14", { x: 7, y: 0, w: 2.7, h: 0.6, fontSize: 9, color: C.cyan, fontFace: "Consolas", align: "right", valign: "middle", charSpacing: 2, margin: 0 });

    s.addText("Defense-in-Depth: Network Segmentation", {
      x: 0.3, y: 0.75, w: 9.4, h: 0.5,
      fontSize: 22, color: C.white, fontFace: "Arial Black", bold: true, margin: 0
    });

    // 5 segments as layered zones
    const zones = [
      { label: "INTERNET", color: C.red,    subnet: "Public",              note: "Untrusted. All traffic filtered at perimeter firewall." },
      { label: "DMZ",      color: C.orange, subnet: "192.168.10.0/28",     note: "Web/mail servers. Internet can initiate connections here." },
      { label: "WORKSTATIONS", color: C.blue2, subnet: "192.168.20.0/24", note: "Isolated per workstation via host firewall rules." },
      { label: "SERVERS",  color: C.purple, subnet: "192.168.30.0/25",     note: "DB & App servers. No direct workstation access." },
      { label: "MGMT NET", color: C.teal,   subnet: "192.168.99.0/28",     note: "Router/Switch administration. Only admin staff access." },
    ];
    zones.forEach((z, i) => {
      const yp = 1.4 + i * 0.78;
      const width = 9.4 - i * 0.3;
      const xp = 0.3 + i * 0.15;
      s.addShape(pres.shapes.RECTANGLE, {
        x: xp, y: yp, w: width, h: 0.7,
        fill: { color: z.color, transparency: 75 },
        line: { color: z.color, width: 1.5 }
      });
      s.addShape(pres.shapes.RECTANGLE, {
        x: xp, y: yp, w: 1.5, h: 0.7,
        fill: { color: z.color, transparency: 50 },
        line: { color: z.color, width: 0 }
      });
      s.addText(z.label, { x: xp + 0.05, y: yp, w: 1.4, h: 0.7, fontSize: 9, color: C.white, fontFace: "Consolas", align: "center", valign: "middle", bold: true, margin: 0 });
      s.addText(z.subnet, { x: xp + 1.6, y: yp, w: 1.6, h: 0.35, fontSize: 8, color: z.color, fontFace: "Consolas", valign: "bottom", margin: 0 });
      s.addText(z.note, { x: xp + 1.6, y: yp + 0.33, w: width - 1.75, h: 0.35, fontSize: 8.5, color: C.white, fontFace: "Calibri", valign: "top", margin: 0 });

      // Firewall between zones
      if (i < 4) {
        s.addShape(pres.shapes.RECTANGLE, { x: 9.35, y: yp + 0.62, w: 0.55, h: 0.25, fill: { color: C.orange, transparency: 30 }, line: { color: C.orange, width: 0.5 } });
        s.addText("ACL", { x: 9.35, y: yp + 0.62, w: 0.55, h: 0.25, fontSize: 7, color: C.orange, fontFace: "Consolas", align: "center", valign: "middle", bold: true, margin: 0 });
      }
    });

    s.addText("Each layer requires separate authentication. Compromise of one zone does not grant access to others.", {
      x: 0.3, y: 5.28, w: 9.4, h: 0.3, fontSize: 9, color: C.gray, fontFace: "Calibri", italic: true, margin: 0
    });
  }

