    s.addShape(pres.shapes.RECTANGLE, { x: 0.3, y: 1.4, w: 9.4, h: 1.5, fill: { color: "1A0808" }, line: { color: C.red, width: 1.5 } });
    s.addText("REAL-WORLD RED TEAM OPERATION", { x: 0.45, y: 1.42, w: 7, h: 0.3, fontSize: 9, color: C.red, fontFace: "Consolas", bold: true, charSpacing: 2, margin: 0 });
    s.addText("During COVID-19, a pentester purchased a physical printer and embedded a reverse shell into its firmware. They shipped it to the target company with a phishing email thanking staff. The printer was connected immediately — and the Domain Administrator's workstation sent NTLMv2 credentials to the printer automatically during a print authentication handshake.\n\nResult: Full domain compromise via a \"free\" printer.", {
      x: 0.45, y: 1.75, w: 9.1, h: 1.1, fontSize: 10, color: C.white, fontFace: "Calibri", margin: 0
    });

    // Attack chain
    s.addText("ATTACK CHAIN:", { x: 0.3, y: 3.05, w: 3, h: 0.28, fontSize: 9, color: C.orange, fontFace: "Consolas", bold: true, margin: 0 });
    const chain = ["Malicious\nPrinter Ships", "Connects to\nFlat Network", "PC Sends\nNTLMv2 Auth", "Credentials\nCaptured", "Domain\nCompromised"];
    chain.forEach((step, i) => {
      const xp = 0.3 + i * 1.88;
      s.addShape(pres.shapes.RECTANGLE, { x: xp, y: 3.35, w: 1.65, h: 0.65, fill: { color: C.panel2 }, line: { color: C.red, width: 1 } });
      s.addText(step, { x: xp, y: 3.35, w: 1.65, h: 0.65, fontSize: 8.5, color: C.white, fontFace: "Calibri", align: "center", valign: "middle", margin: 0 });
      if (i < 4) s.addText("→", { x: xp + 1.67, y: 3.5, w: 0.2, h: 0.35, fontSize: 12, color: C.red, fontFace: "Arial", align: "center", margin: 0 });
    });

    // Prevention controls
    s.addText("PREVENTION (If segmented properly):", { x: 0.3, y: 4.15, w: 5, h: 0.28, fontSize: 9, color: C.green, fontFace: "Consolas", bold: true, margin: 0 });
    const prevents = [
      "Printer VLAN blocked from internet egress",
      "Workstation→Printer communication blocked on port 445",
      "Printer cannot initiate TCP connections to workstations",
      "NTLMv2 relay mitigated by SMB signing enforcement"
    ];
    prevents.forEach((p, i) => {
      s.addText([
        { text: "✓  ", options: { color: C.green, bold: true } },
        { text: p, options: { color: C.white } }
      ], { x: 0.4, y: 4.48 + i * 0.28, w: 9.2, h: 0.26, fontSize: 10, fontFace: "Calibri", margin: 0 });
    });
  }

