        { text: "/25", options: { color: C.orange, fill: { color: C.panel2 } } },
        { text: "10.20.0.128–255  (second half)", options: { color: C.gray, fontFace: "Consolas", fill: { color: C.panel2 } } },
        { text: "YES (gateway)", options: { color: C.green, fill: { color: C.panel2 } } }
      ],
