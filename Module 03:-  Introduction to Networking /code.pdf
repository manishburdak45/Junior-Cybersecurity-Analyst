    s.addText("LINUX FIREWALL EQUIVALENT (iptables):", { x: 0.45, y: 4.52, w: 9.1, h: 0.22, fontSize: 8, color: C.green, fontFace: "Consolas", bold: true, margin: 0 });
    s.addText("# Block printer subnet from reaching SMB ports on all hosts\niptables -A FORWARD -s 192.168.40.0/28 -p tcp --dport 445 -j DROP\niptables -A FORWARD -s 192.168.40.0/28 -d 0.0.0.0/0 -j DROP", {
