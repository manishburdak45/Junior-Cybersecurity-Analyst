      s.addShape(pres.shapes.RECTANGLE, { x: xp, y: yp, w: 4.6, h: 1.9, fill: { color: C.panel }, line: { color: c.color, width: 1 } });
      s.addShape(pres.shapes.RECTANGLE, { x: xp, y: yp, w: 4.6, h: 0.04, fill: { color: c.color }, line: { color: c.color, width: 0 } });
