    s.addShape(pres.shapes.RECTANGLE, { x: 0.3, y: 1.4, w: 0.06, h: 0.55, fill: { color: C.orange }, line: { color: C.orange, width: 0 } });
    s.addText("Access Control Lists (ACLs) define which traffic is PERMITTED or DENIED between network segments — implemented on routers, L3 switches, and firewalls.", {
