    const tableData = [
      [
        { text: "DEVICE", options: { bold: true, color: C.white, fill: { color: C.blue } } },
        { text: "IP ADDRESS", options: { bold: true, color: C.white, fill: { color: C.blue } } },
        { text: "SUBNET", options: { bold: true, color: C.white, fill: { color: C.blue } } },
        { text: "NETWORK HALF", options: { bold: true, color: C.white, fill: { color: C.blue } } },
        { text: "REACHABLE?", options: { bold: true, color: C.white, fill: { color: C.blue } } }
      ],
