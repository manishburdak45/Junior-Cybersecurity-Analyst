    s.addImage({ data: iconWarn, x: 0.45, y: 1.45, w: 0.4, h: 0.4 });
    s.addText("REAL PENTEST SCENARIO:", { x: 0.95, y: 1.35, w: 5, h: 0.3, fontSize: 9, color: C.orange, fontFace: "Consolas", bold: true, valign: "bottom", margin: 0 });
    s.addText("A pentester reported the Domain Controller as \"offline\" — it was actually on a /25 subnet they couldn't reach because they misconfigured their subnet mask as /24!", {
