    s.addText("SLIDE 08 / 14", { x: 7, y: 0, w: 2.7, h: 0.6, fontSize: 9, color: C.cyan, fontFace: "Consolas", align: "right", valign: "middle", charSpacing: 2, margin: 0 });

    s.addText("Enterprise Network Components", {
      x: 0.3, y: 0.75, w: 9.4, h: 0.5,
      fontSize: 22, color: C.white, fontFace: "Arial Black", bold: true, margin: 0
    });

    const components = [
      { icon: iconRouter, title: "Router", subnet: "Admin Net 192.168.99.0/28", desc: "Routes traffic between networks. Must be on isolated Admin VLAN to prevent OSPF hijacking and routing attacks.", threat: "OSPF spoofing, route injection", color: C.cyan },
      { icon: iconServer, title: "Switch (L2/L3)", subnet: "Admin Net 192.168.99.0/28", desc: "Connects devices within a segment. Managed switches support VLANs. Separate from user networks.", threat: "ARP spoofing, MAC flooding, VLAN hopping", color: C.blue2 },
      { icon: iconFire, title: "Firewall", subnet: "Perimeter / Segment ACLs", desc: "Filters traffic between zones. Applies ACLs. Stateful inspection tracks connection state.", threat: "Misconfiguration, rule bypass", color: C.orange },
      { icon: iconShield, title: "IDS/IPS (Suricata / Snort)", subnet: "Monitoring all segments", desc: "Intrusion Detection/Prevention systems. Suricata and Snort detect port scans, exploits, and anomalies in real-time.", threat: "Evasion via fragmentation, slow scans", color: C.green },
    ];

    components.forEach((c, i) => {
      const xp = 0.25 + (i % 2) * 4.9;
