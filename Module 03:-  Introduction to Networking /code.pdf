    s.addText("SLIDE 05 / 14", { x: 7, y: 0, w: 2.7, h: 0.6, fontSize: 9, color: C.cyan, fontFace: "Consolas", align: "right", valign: "middle", charSpacing: 2, margin: 0 });

    s.addText("How the Internet Works: Packet Journey", {
      x: 0.3, y: 0.75, w: 9.4, h: 0.5,
      fontSize: 22, color: C.white, fontFace: "Arial Black", bold: true, margin: 0
    });

    // Journey steps
    const steps = [
      { num: "01", title: "Browser Request", desc: "User types hackthebox.eu\nURL resolved to FQDN", icon: "💻", color: C.blue2 },
      { num: "02", title: "Home Router", desc: "Your gateway routes\npacket to ISP", icon: "🏠", color: C.cyan },
      { num: "03", title: "DNS Lookup", desc: "ISP queries DNS server\nFQDN → IP Address", icon: "📖", color: C.teal },
      { num: "04", title: "ISP Backbone", desc: "Packet traverses the\ninternet backbone", icon: "🌐", color: C.purple },
      { num: "05", title: "Web Server", desc: "Target server receives\nHTTP/HTTPS request", icon: "🖥️", color: C.green },
    ];

    steps.forEach((st, i) => {
      const xp = 0.25 + i * 1.92;
      // Box
      s.addShape(pres.shapes.RECTANGLE, {
        x: xp, y: 1.4, w: 1.7, h: 2.4,
        fill: { color: C.panel }, line: { color: st.color, width: 1 }
      });
      s.addShape(pres.shapes.RECTANGLE, {
        x: xp, y: 1.4, w: 1.7, h: 0.04,
        fill: { color: st.color }, line: { color: st.color, width: 0 }
      });
      // Step number badge
      s.addShape(pres.shapes.OVAL, {
        x: xp + 0.62, y: 1.55, w: 0.45, h: 0.45,
        fill: { color: st.color, transparency: 20 }, line: { color: st.color, width: 1 }
      });
      s.addText(st.num, { x: xp + 0.62, y: 1.55, w: 0.45, h: 0.45, fontSize: 11, color: C.white, fontFace: "Arial Black", align: "center", valign: "middle", bold: true, margin: 0 });
      s.addText(st.title, { x: xp + 0.05, y: 2.1, w: 1.6, h: 0.35, fontSize: 10, color: st.color, fontFace: "Consolas", align: "center", bold: true, margin: 0 });
      s.addText(st.desc, { x: xp + 0.05, y: 2.5, w: 1.6, h: 0.8, fontSize: 9, color: C.white, fontFace: "Calibri", align: "center", margin: 0 });

      // Arrow between steps
      if (i < 4) {
        s.addShape(pres.shapes.LINE, {
          x: xp + 1.72, y: 2.6, w: 0.18, h: 0,
          line: { color: C.cyan3, width: 2 }
        });
        s.addText("→", { x: xp + 1.72, y: 2.5, w: 0.2, h: 0.25, fontSize: 12, color: C.cyan, fontFace: "Arial", align: "center", margin: 0 });
      }
    });

    // FQDN vs URL explanation
    s.addShape(pres.shapes.RECTANGLE, { x: 0.3, y: 4.0, w: 4.5, h: 1.3, fill: { color: C.panel2 }, line: { color: C.cyan3, width: 1 } });
    s.addText("FQDN vs URL", { x: 0.4, y: 4.0, w: 4.3, h: 0.3, fontSize: 10, color: C.cyan, fontFace: "Consolas", bold: true, margin: 0 });
    s.addText([
      { text: "FQDN: ", options: { bold: true, color: C.cyan } },
      { text: "www.hackthebox.eu  → just the address\n", options: { color: C.white } },
      { text: "URL:  ", options: { bold: true, color: C.teal } },
      { text: "https://hackthebox.eu/path?param=val  → full location", options: { color: C.white } }
    ], { x: 0.4, y: 4.3, w: 4.3, h: 0.95, fontSize: 10, fontFace: "Consolas", margin: 0 });

    // DNS packet flow
    s.addShape(pres.shapes.RECTANGLE, { x: 5.1, y: 4.0, w: 4.7, h: 1.3, fill: { color: C.panel2 }, line: { color: C.teal, width: 1 } });
    s.addImage({ data: iconDns, x: 5.2, y: 4.05, w: 0.35, h: 0.35 });
    s.addText("DNS Resolution Flow", { x: 5.65, y: 4.0, w: 4.0, h: 0.35, fontSize: 10, color: C.teal, fontFace: "Consolas", bold: true, valign: "middle", margin: 0 });
    s.addText("Browser → Recursive Resolver → Root NS → TLD NS → Auth NS → IP\nResult cached locally (TTL). Command: dig hackthebox.eu A", {
      x: 5.2, y: 4.38, w: 4.5, h: 0.85, fontSize: 9.5, color: C.white, fontFace: "Calibri", margin: 0
    });
  }

  // ─────────────────────────────────────────────────────────────────
