const pptxgen = require("pptxgenjs");
const React = require("react");
const ReactDOMServer = require("react-dom/server");
const sharp = require("sharp");

// Icon imports
const {
  FaNetworkWired, FaShieldAlt, FaServer, FaLock,
  FaExclamationTriangle, FaTerminal, FaEye, FaDatabase,
  FaWifi, FaRoute, FaFireAlt, FaSearch
} = require("react-icons/fa");
const { MdSecurity, MdDns, MdRouter } = require("react-icons/md");
const { BiNetworkChart } = require("react-icons/bi");

async function iconToBase64Png(IconComponent, color, size = 256) {
  const svg = ReactDOMServer.renderToStaticMarkup(
    React.createElement(IconComponent, { color, size: String(size) })
  );
  const pngBuffer = await sharp(Buffer.from(svg)).png().toBuffer();
  return "image/png;base64," + pngBuffer.toString("base64");
}

// COLOR PALETTE - Dark Cybersecurity Theme
const C = {
  bg:        "0A0E1A",   // Deep dark navy
  bg2:       "0D1525",   // Slightly lighter dark
  panel:     "111827",   // Card background
  panel2:    "1A2540",   // Lighter panel
  cyan:      "00D4FF",   // Neon cyan accent
  cyan2:     "00A8CC",   // Darker cyan
  cyan3:     "0077AA",   // Muted cyan
  blue:      "1E40AF",   // Deep blue
  blue2:     "3B82F6",   // Bright blue
  green:     "10B981",   // Success green
  red:       "EF4444",   // Warning red
  orange:    "F59E0B",   // Alert orange
  white:     "FFFFFF",
  gray:      "94A3B8",
  gray2:     "64748B",
  gray3:     "334155",
  teal:      "14B8A6",
  purple:    "8B5CF6",
};

async function buildPresentation() {
  const pres = new pptxgen();
  pres.layout = "LAYOUT_16x9";
  pres.title = "Networking Overview for Cybersecurity Beginners";
  pres.author = "CyberSec Training";

  // Pre-render icons
  const iconNetwork = await iconToBase64Png(FaNetworkWired, "#00D4FF", 256);
  const iconShield   = await iconToBase64Png(FaShieldAlt,    "#00D4FF", 256);
  const iconServer   = await iconToBase64Png(FaServer,       "#00D4FF", 256);
  const iconLock     = await iconToBase64Png(FaLock,         "#00D4FF", 256);
  const iconWarn     = await iconToBase64Png(FaExclamationTriangle, "#EF4444", 256);
  const iconTerm     = await iconToBase64Png(FaTerminal,     "#10B981", 256);
  const iconEye      = await iconToBase64Png(FaEye,          "#00D4FF", 256);
  const iconFire     = await iconToBase64Png(FaFireAlt,      "#F59E0B", 256);
  const iconDns      = await iconToBase64Png(MdDns,          "#00D4FF", 256);
  const iconRouter   = await iconToBase64Png(MdRouter,       "#00D4FF", 256);
  const iconSearch   = await iconToBase64Png(FaSearch,       "#00D4FF", 256);

  // ─────────────────────────────────────────────────────────────────
  // SLIDE 1 — TITLE SLIDE
  // ─────────────────────────────────────────────────────────────────
  {
    const s = pres.addSlide();
    s.background = { color: C.bg };

    // Grid line decorations (subtle)
    for (let i = 0; i < 8; i++) {
      s.addShape(pres.shapes.LINE, {
        x: i * 1.4, y: 0, w: 0, h: 5.625,
        line: { color: "1E3A5F", width: 0.5, transparency: 60 }
      });
    }
    for (let j = 0; j < 5; j++) {
      s.addShape(pres.shapes.LINE, {
        x: 0, y: j * 1.2, w: 10, h: 0,
        line: { color: "1E3A5F", width: 0.5, transparency: 60 }
      });
    }

    // Glowing left accent bar
    s.addShape(pres.shapes.RECTANGLE, {
      x: 0, y: 0, w: 0.06, h: 5.625,
      fill: { color: C.cyan }, line: { color: C.cyan, width: 0 }
    });

    // Central panel
    s.addShape(pres.shapes.RECTANGLE, {
      x: 0.5, y: 0.7, w: 9, h: 4.2,
      fill: { color: C.panel, transparency: 20 },
      line: { color: C.cyan3, width: 1 }
    });

    // Cyan top strip on panel
    s.addShape(pres.shapes.RECTANGLE, {
      x: 0.5, y: 0.7, w: 9, h: 0.06,
      fill: { color: C.cyan }, line: { color: C.cyan, width: 0 }
    });

    // Module label
    s.addText("HTB ACADEMY  |  MODULE 01", {
      x: 0.7, y: 0.9, w: 8.6, h: 0.3,
      fontSize: 9, color: C.cyan, fontFace: "Consolas",
      charSpacing: 4, margin: 0
    });

    // Main title
    s.addText("NETWORKING OVERVIEW", {
      x: 0.7, y: 1.35, w: 8.6, h: 0.85,
      fontSize: 40, color: C.white, fontFace: "Arial Black",
      bold: true, charSpacing: 2, margin: 0
    });

    // Subtitle
    s.addText("for Cybersecurity Beginners", {
      x: 0.7, y: 2.2, w: 8.6, h: 0.5,
      fontSize: 22, color: C.cyan, fontFace: "Calibri",
      italic: true, margin: 0
    });

    // Separator line
    s.addShape(pres.shapes.LINE, {
      x: 0.7, y: 2.85, w: 8.6, h: 0,
      line: { color: C.gray3, width: 1 }
    });

    // Tags row
    const tags = ["Network Topology", "Subnetting", "Defense-in-Depth", "Traffic Flow", "Practical Labs"];
    tags.forEach((t, i) => {
      const xPos = 0.7 + i * 1.76;
      s.addShape(pres.shapes.RECTANGLE, {
        x: xPos, y: 3.0, w: 1.65, h: 0.32,
        fill: { color: C.blue, transparency: 40 },
        line: { color: C.cyan3, width: 0.5 }
      });
      s.addText(t, {
        x: xPos, y: 3.0, w: 1.65, h: 0.32,
        fontSize: 7.5, color: C.cyan, fontFace: "Consolas",
        align: "center", valign: "middle", margin: 0
      });
    });

    // Bottom footer
    s.addText("BEGINNER  →  INTERMEDIATE  |  PRACTICAL LAB INCLUDED", {
      x: 0.7, y: 3.6, w: 8.6, h: 0.25,
      fontSize: 8, color: C.gray, fontFace: "Consolas",
      charSpacing: 2, margin: 0
    });

    // Network icon
    s.addImage({ data: iconNetwork, x: 8.2, y: 3.95, w: 0.7, h: 0.7 });

    s.addText("\"Understanding the network is the first step to securing it.\"", {
      x: 0.7, y: 4.1, w: 7.3, h: 0.4,
      fontSize: 10, color: C.gray, fontFace: "Calibri",
      italic: true, margin: 0
    });
  }

  // ─────────────────────────────────────────────────────────────────
  // SLIDE 2 — WHAT IS A NETWORK?
  // ─────────────────────────────────────────────────────────────────
  {
    const s = pres.addSlide();
    s.background = { color: C.bg };

    // Top header bar
    s.addShape(pres.shapes.RECTANGLE, {
      x: 0, y: 0, w: 10, h: 0.6,
      fill: { color: C.panel }, line: { color: C.panel, width: 0 }
    });
    s.addShape(pres.shapes.RECTANGLE, {
      x: 0, y: 0.6, w: 10, h: 0.04,
      fill: { color: C.cyan }, line: { color: C.cyan, width: 0 }
    });
    s.addText("MODULE 01  |  NETWORKING OVERVIEW", {
      x: 0.3, y: 0, w: 6, h: 0.6,
      fontSize: 9, color: C.gray, fontFace: "Consolas",
      valign: "middle", charSpacing: 2, margin: 0
    });
    s.addText("SLIDE 02 / 14", {
      x: 7, y: 0, w: 2.7, h: 0.6,
      fontSize: 9, color: C.cyan, fontFace: "Consolas",
      align: "right", valign: "middle", charSpacing: 2, margin: 0
    });

    // Slide title
    s.addImage({ data: iconNetwork, x: 0.3, y: 0.8, w: 0.45, h: 0.45 });
    s.addText("What Is a Network?", {
      x: 0.85, y: 0.8, w: 9, h: 0.45,
      fontSize: 24, color: C.white, fontFace: "Arial Black",
      bold: true, valign: "middle", margin: 0
    });

    // Definition card
    s.addShape(pres.shapes.RECTANGLE, {
      x: 0.3, y: 1.45, w: 9.4, h: 0.7,
      fill: { color: C.panel2 }, line: { color: C.cyan, width: 1 }
    });
    s.addShape(pres.shapes.RECTANGLE, {
      x: 0.3, y: 1.45, w: 0.06, h: 0.7,
      fill: { color: C.cyan }, line: { color: C.cyan, width: 0 }
    });
    s.addText("A network enables two or more computers to communicate with each other by sharing data, resources, and services across a defined medium.", {
      x: 0.5, y: 1.45, w: 9.1, h: 0.7,
      fontSize: 12, color: C.white, fontFace: "Calibri",
      valign: "middle", margin: 0
    });

    // 3 concept columns
    const cols = [
      { title: "TOPOLOGY", icon: "🔷", desc: "Physical/logical arrangement\nof nodes in a network\n\nMesh · Tree · Star · Bus" },
      { title: "MEDIUM", icon: "🔷", desc: "The physical or wireless path\ndata travels through\n\nEthernet · Fiber · Wi-Fi · Coax" },
      { title: "PROTOCOL", icon: "🔷", desc: "Rules governing how data\nis transmitted and received\n\nTCP · UDP · ICMP · ARP" }
    ];
    cols.forEach((col, i) => {
      const xp = 0.3 + i * 3.2;
      s.addShape(pres.shapes.RECTANGLE, {
        x: xp, y: 2.3, w: 3.0, h: 1.9,
        fill: { color: C.panel }, line: { color: C.cyan3, width: 1 }
      });
      s.addShape(pres.shapes.RECTANGLE, {
        x: xp, y: 2.3, w: 3.0, h: 0.04,
        fill: { color: C.cyan }, line: { color: C.cyan, width: 0 }
      });
      s.addText(col.title, {
        x: xp, y: 2.38, w: 3.0, h: 0.3,
        fontSize: 11, color: C.cyan, fontFace: "Consolas",
        align: "center", bold: true, margin: 0
      });
      s.addText(col.desc, {
        x: xp + 0.1, y: 2.75, w: 2.8, h: 1.35,
        fontSize: 10, color: C.white, fontFace: "Calibri",
        valign: "top", margin: 0
      });
    });

    // Cybersecurity relevance callout
    s.addShape(pres.shapes.RECTANGLE, {
      x: 0.3, y: 4.35, w: 9.4, h: 0.9,
      fill: { color: "0D2040" }, line: { color: C.blue2, width: 1 }
    });
    s.addImage({ data: iconShield, x: 0.45, y: 4.5, w: 0.35, h: 0.35 });
    s.addText("WHY IT MATTERS IN CYBERSECURITY:", {
      x: 0.9, y: 4.35, w: 8.5, h: 0.35,
      fontSize: 9, color: C.blue2, fontFace: "Consolas",
      bold: true, valign: "bottom", charSpacing: 1, margin: 0
    });
    s.addText("Network failures are often silent — misconfigured subnets can hide entire server segments. Attackers exploit flat networks with minimal lateral movement resistance.", {
      x: 0.9, y: 4.68, w: 8.4, h: 0.5,
      fontSize: 10, color: C.gray, fontFace: "Calibri",
      valign: "top", margin: 0
    });
  }

  // ─────────────────────────────────────────────────────────────────
  // SLIDE 3 — NETWORK TOPOLOGIES (visual diagram)
  // ─────────────────────────────────────────────────────────────────
  {
    const s = pres.addSlide();
    s.background = { color: C.bg };

    // Header
    s.addShape(pres.shapes.RECTANGLE, { x: 0, y: 0, w: 10, h: 0.6, fill: { color: C.panel }, line: { color: C.panel, width: 0 } });
    s.addShape(pres.shapes.RECTANGLE, { x: 0, y: 0.6, w: 10, h: 0.04, fill: { color: C.cyan }, line: { color: C.cyan, width: 0 } });
    s.addText("MODULE 01  |  NETWORKING OVERVIEW", { x: 0.3, y: 0, w: 6, h: 0.6, fontSize: 9, color: C.gray, fontFace: "Consolas", valign: "middle", charSpacing: 2, margin: 0 });
    s.addText("SLIDE 03 / 14", { x: 7, y: 0, w: 2.7, h: 0.6, fontSize: 9, color: C.cyan, fontFace: "Consolas", align: "right", valign: "middle", charSpacing: 2, margin: 0 });

    s.addText("Network Topologies", {
      x: 0.3, y: 0.75, w: 9.4, h: 0.5,
      fontSize: 24, color: C.white, fontFace: "Arial Black", bold: true, margin: 0
    });

    // ── STAR TOPOLOGY (left) ──
    s.addShape(pres.shapes.RECTANGLE, { x: 0.2, y: 1.35, w: 2.9, h: 3.9, fill: { color: C.panel }, line: { color: C.cyan3, width: 1 } });
    s.addText("STAR", { x: 0.2, y: 1.35, w: 2.9, h: 0.3, fontSize: 10, color: C.cyan, fontFace: "Consolas", align: "center", bold: true, margin: 0 });

    // Central switch node
    s.addShape(pres.shapes.OVAL, { x: 1.3, y: 2.35, w: 0.5, h: 0.5, fill: { color: C.cyan }, line: { color: C.cyan, width: 0 } });
    s.addText("SW", { x: 1.3, y: 2.35, w: 0.5, h: 0.5, fontSize: 8, color: C.bg, fontFace: "Consolas", align: "center", valign: "middle", bold: true, margin: 0 });

    // Star endpoints
    const starPts = [[0.35, 1.8], [1.9, 1.8], [0.35, 3.1], [1.9, 3.1], [1.3, 4.4]];
    starPts.forEach(([px, py]) => {
      s.addShape(pres.shapes.OVAL, { x: px, y: py, w: 0.38, h: 0.38, fill: { color: C.panel2 }, line: { color: C.blue2, width: 1.5 } });
      // Line to center
      s.addShape(pres.shapes.LINE, {
        x: px + 0.19, y: py + 0.19, w: 1.55 - px, h: 2.6 - py,
        line: { color: C.cyan3, width: 1 }
      });
    });
    s.addText("Central hub/switch\nconnects all devices\n\n✓ Easy to manage\n✓ Fault isolation\n✗ Single point of failure", {
      x: 0.25, y: 4.85, w: 2.8, h: 0.6,
      fontSize: 8.5, color: C.gray, fontFace: "Calibri", margin: 0
    });

    // ── MESH TOPOLOGY (center) ──
    s.addShape(pres.shapes.RECTANGLE, { x: 3.35, y: 1.35, w: 3.2, h: 3.9, fill: { color: C.panel }, line: { color: C.cyan3, width: 1 } });
    s.addText("MESH", { x: 3.35, y: 1.35, w: 3.2, h: 0.3, fontSize: 10, color: C.cyan, fontFace: "Consolas", align: "center", bold: true, margin: 0 });

    // 4 mesh nodes
    const meshNodes = [[3.6, 1.85], [6.1, 1.85], [3.6, 3.5], [6.1, 3.5]];
    meshNodes.forEach(([px, py]) => {
      s.addShape(pres.shapes.OVAL, { x: px, y: py, w: 0.42, h: 0.42, fill: { color: C.panel2 }, line: { color: C.green, width: 1.5 } });
    });
    // Mesh connections
    const meshConnections = [[0,1],[0,2],[0,3],[1,2],[1,3],[2,3]];
    meshConnections.forEach(([a, b]) => {
      const [ax, ay] = meshNodes[a], [bx, by] = meshNodes[b];
      s.addShape(pres.shapes.LINE, {
        x: ax + 0.21, y: ay + 0.21, w: bx - ax, h: by - ay,
        line: { color: C.green, width: 1, transparency: 40 }
      });
    });
    s.addText("Every node connects\nto every other node\n\n✓ Highly redundant\n✓ No single failure point\n✗ Expensive/complex", {
      x: 3.4, y: 4.85, w: 3.1, h: 0.6,
      fontSize: 8.5, color: C.gray, fontFace: "Calibri", margin: 0
    });

    // ── TREE TOPOLOGY (right) ──
    s.addShape(pres.shapes.RECTANGLE, { x: 6.8, y: 1.35, w: 3.0, h: 3.9, fill: { color: C.panel }, line: { color: C.cyan3, width: 1 } });
    s.addText("TREE", { x: 6.8, y: 1.35, w: 3.0, h: 0.3, fontSize: 10, color: C.cyan, fontFace: "Consolas", align: "center", bold: true, margin: 0 });

    // Root
    s.addShape(pres.shapes.OVAL, { x: 8.1, y: 1.8, w: 0.45, h: 0.45, fill: { color: C.orange }, line: { color: C.orange, width: 0 } });
    // Level 2
    const treeL2 = [[7.35, 2.7], [8.85, 2.7]];
    treeL2.forEach(([px, py]) => {
      s.addShape(pres.shapes.OVAL, { x: px, y: py, w: 0.4, h: 0.4, fill: { color: C.panel2 }, line: { color: C.orange, width: 1.5 } });
      s.addShape(pres.shapes.LINE, { x: px + 0.2, y: py, w: 8.33 - px, h: -0.55, line: { color: C.orange, width: 1 } });
    });
    // Level 3
    const treeL3 = [[7.0, 3.65], [7.65, 3.65], [8.5, 3.65], [9.15, 3.65]];
    treeL3.forEach(([px, py], i) => {
      s.addShape(pres.shapes.OVAL, { x: px, y: py, w: 0.35, h: 0.35, fill: { color: C.panel2 }, line: { color: C.gray3, width: 1 } });
      const parentX = i < 2 ? treeL2[0][0] + 0.2 : treeL2[1][0] + 0.2;
      const parentY = treeL2[i < 2 ? 0 : 1][1] + 0.4;
      s.addShape(pres.shapes.LINE, { x: px + 0.175, y: py, w: parentX - px - 0.175, h: parentY - py, line: { color: C.gray3, width: 1 } });
    });
    s.addText("Hierarchical structure\nlike enterprise LANs\n\n✓ Scalable design\n✓ Segment isolation\n✗ Root failure = outage", {
      x: 6.85, y: 4.85, w: 2.9, h: 0.6,
      fontSize: 8.5, color: C.gray, fontFace: "Calibri", margin: 0
    });
  }

  // ─────────────────────────────────────────────────────────────────
  // SLIDE 4 — FLAT vs SEGMENTED NETWORK
  // ─────────────────────────────────────────────────────────────────
  {
    const s = pres.addSlide();
    s.background = { color: C.bg };

    s.addShape(pres.shapes.RECTANGLE, { x: 0, y: 0, w: 10, h: 0.6, fill: { color: C.panel }, line: { color: C.panel, width: 0 } });
    s.addShape(pres.shapes.RECTANGLE, { x: 0, y: 0.6, w: 10, h: 0.04, fill: { color: C.red }, line: { color: C.red, width: 0 } });
    s.addText("MODULE 01  |  NETWORKING OVERVIEW", { x: 0.3, y: 0, w: 6, h: 0.6, fontSize: 9, color: C.gray, fontFace: "Consolas", valign: "middle", charSpacing: 2, margin: 0 });
    s.addText("SLIDE 04 / 14", { x: 7, y: 0, w: 2.7, h: 0.6, fontSize: 9, color: C.red, fontFace: "Consolas", align: "right", valign: "middle", charSpacing: 2, margin: 0 });

    s.addText("Flat Network vs. Segmented Network", {
      x: 0.3, y: 0.75, w: 9.4, h: 0.5,
      fontSize: 22, color: C.white, fontFace: "Arial Black", bold: true, margin: 0
    });

    // ── FLAT NETWORK (left panel) ──
    s.addShape(pres.shapes.RECTANGLE, { x: 0.2, y: 1.4, w: 4.5, h: 3.85, fill: { color: C.panel }, line: { color: C.red, width: 1.5 } });
    s.addShape(pres.shapes.RECTANGLE, { x: 0.2, y: 1.4, w: 4.5, h: 0.32, fill: { color: "3B0A0A" }, line: { color: C.red, width: 0 } });
    s.addText("FLAT NETWORK  — /24 Subnet", { x: 0.3, y: 1.4, w: 4.3, h: 0.32, fontSize: 10, color: C.red, fontFace: "Consolas", valign: "middle", bold: true, margin: 0 });

    // Flat network: single bus
    s.addShape(pres.shapes.LINE, { x: 0.5, y: 2.85, w: 3.9, h: 0, line: { color: C.gray2, width: 3 } });
    const flatDevices = [
      { x: 0.55, label: "PC\n.100", color: C.blue2 },
      { x: 1.25, label: "Printer\n.110", color: C.orange },
      { x: 2.0, label: "Server\n.50", color: C.green },
      { x: 2.8, label: "DB\n.60", color: C.purple },
      { x: 3.55, label: "IP Phone\n.130", color: C.cyan },
    ];
    flatDevices.forEach(d => {
      s.addShape(pres.shapes.RECTANGLE, { x: d.x, y: 2.15, w: 0.6, h: 0.55, fill: { color: d.color, transparency: 30 }, line: { color: d.color, width: 1 } });
      s.addText(d.label, { x: d.x, y: 2.15, w: 0.6, h: 0.55, fontSize: 6.5, color: C.white, fontFace: "Consolas", align: "center", valign: "middle", margin: 0 });
      s.addShape(pres.shapes.LINE, { x: d.x + 0.3, y: 2.7, w: 0, h: 0.15, line: { color: C.gray2, width: 1.5 } });
    });

    // Attack arrow on flat
    s.addShape(pres.shapes.RECTANGLE, { x: 0.3, y: 3.2, w: 4.1, h: 0.9, fill: { color: "2A0808" }, line: { color: C.red, width: 1, dashType: "dash" } });
    s.addImage({ data: iconWarn, x: 0.4, y: 3.3, w: 0.3, h: 0.3 });
    s.addText("ATTACK RISK: Printer compromised → directly reaches DB server\nNo ACLs, no segmentation, lateral movement is trivial!", {
      x: 0.8, y: 3.2, w: 3.5, h: 0.9, fontSize: 8.5, color: C.red, fontFace: "Calibri", valign: "middle", margin: 0
    });
    s.addText("192.168.1.0/24  —  ALL devices in same broadcast domain", {
      x: 0.3, y: 4.15, w: 4.3, h: 0.35, fontSize: 8, color: C.gray, fontFace: "Consolas", margin: 0
    });
    s.addText("Printers can reach Domain Controllers!\nPort scans go unchallenged across all hosts.", {
      x: 0.3, y: 4.55, w: 4.3, h: 0.6, fontSize: 9, color: C.orange, fontFace: "Calibri", margin: 0
    });

    // ── SEGMENTED NETWORK (right panel) ──
    s.addShape(pres.shapes.RECTANGLE, { x: 5.1, y: 1.4, w: 4.7, h: 3.85, fill: { color: C.panel }, line: { color: C.green, width: 1.5 } });
    s.addShape(pres.shapes.RECTANGLE, { x: 5.1, y: 1.4, w: 4.7, h: 0.32, fill: { color: "0A2A0A" }, line: { color: C.green, width: 0 } });
    s.addText("SEGMENTED NETWORK  — VLANs + ACLs", { x: 5.2, y: 1.4, w: 4.5, h: 0.32, fontSize: 10, color: C.green, fontFace: "Consolas", valign: "middle", bold: true, margin: 0 });

    // Segments
    const segs = [
      { y: 1.85, label: "DMZ  192.168.10.0/28", color: C.orange, dev: "Web Server" },
      { y: 2.55, label: "WORKSTATIONS  192.168.20.0/24", color: C.blue2, dev: "PC / Laptop" },
      { y: 3.25, label: "SERVERS  192.168.30.0/25", color: C.purple, dev: "DB / App" },
      { y: 3.95, label: "PRINTERS  192.168.40.0/28", color: C.gray2, dev: "Printer" },
    ];
    segs.forEach(seg => {
      s.addShape(pres.shapes.RECTANGLE, { x: 5.2, y: seg.y, w: 4.5, h: 0.55, fill: { color: seg.color, transparency: 80 }, line: { color: seg.color, width: 1 } });
      s.addText(seg.label, { x: 5.35, y: seg.y + 0.02, w: 3.2, h: 0.28, fontSize: 8, color: seg.color, fontFace: "Consolas", bold: true, margin: 0 });
      s.addText(seg.dev, { x: 5.35, y: seg.y + 0.28, w: 2.5, h: 0.22, fontSize: 8, color: C.white, fontFace: "Calibri", margin: 0 });
      // Firewall icon text
      s.addShape(pres.shapes.RECTANGLE, { x: 9.05, y: seg.y + 0.08, w: 0.55, h: 0.35, fill: { color: C.orange, transparency: 60 }, line: { color: C.orange, width: 0.5 } });
      s.addText("FW", { x: 9.05, y: seg.y + 0.08, w: 0.55, h: 0.35, fontSize: 8, color: C.orange, fontFace: "Consolas", align: "center", valign: "middle", bold: true, margin: 0 });
    });
    s.addText("[FIREWALL / ACL]", { x: 9.0, y: 1.4, w: 0.75, h: 0.35, fontSize: 6, color: C.orange, fontFace: "Consolas", align: "center", margin: 0 });
    s.addText("Printer compromised? → Cannot reach DB.\nACL blocks cross-segment traffic!", {
      x: 5.2, y: 4.6, w: 4.3, h: 0.55, fontSize: 9, color: C.green, fontFace: "Calibri", margin: 0
    });
  }

  // ─────────────────────────────────────────────────────────────────
  // SLIDE 5 — HOW THE INTERNET WORKS (Packet Journey)
  // ─────────────────────────────────────────────────────────────────
  {
    const s = pres.addSlide();
    s.background = { color: C.bg };

    s.addShape(pres.shapes.RECTANGLE, { x: 0, y: 0, w: 10, h: 0.6, fill: { color: C.panel }, line: { color: C.panel, width: 0 } });
    s.addShape(pres.shapes.RECTANGLE, { x: 0, y: 0.6, w: 10, h: 0.04, fill: { color: C.cyan }, line: { color: C.cyan, width: 0 } });
