  // ─────────────────────────────────────────────────────────────────
  {
    const s = pres.addSlide();
    s.background = { color: C.bg };

    s.addShape(pres.shapes.RECTANGLE, { x: 0, y: 0, w: 10, h: 0.6, fill: { color: C.panel }, line: { color: C.panel, width: 0 } });
    s.addShape(pres.shapes.RECTANGLE, { x: 0, y: 0.6, w: 10, h: 0.04, fill: { color: C.teal }, line: { color: C.teal, width: 0 } });
    s.addText("MODULE 01  |  NETWORKING OVERVIEW", { x: 0.3, y: 0, w: 6, h: 0.6, fontSize: 9, color: C.gray, fontFace: "Consolas", valign: "middle", charSpacing: 2, margin: 0 });
    s.addText("SLIDE 13 / 14", { x: 7, y: 0, w: 2.7, h: 0.6, fontSize: 9, color: C.teal, fontFace: "Consolas", align: "right", valign: "middle", charSpacing: 2, margin: 0 });

    s.addImage({ data: iconSearch, x: 0.3, y: 0.77, w: 0.45, h: 0.45 });
    s.addText("Practical Lab: Wireshark & Nmap Analysis", {
      x: 0.85, y: 0.75, w: 9, h: 0.5,
      fontSize: 20, color: C.white, fontFace: "Arial Black", bold: true, valign: "middle", margin: 0
    });

    // Wireshark section
    s.addShape(pres.shapes.RECTANGLE, { x: 0.2, y: 1.4, w: 4.7, h: 3.85, fill: { color: C.panel }, line: { color: C.teal, width: 1 } });
    s.addShape(pres.shapes.RECTANGLE, { x: 0.2, y: 1.4, w: 4.7, h: 0.3, fill: { color: C.teal, transparency: 70 }, line: { color: C.teal, width: 0 } });
    s.addText("WIRESHARK — PACKET CAPTURE", { x: 0.3, y: 1.4, w: 4.5, h: 0.3, fontSize: 9, color: C.teal, fontFace: "Consolas", bold: true, valign: "middle", margin: 0 });

    // Simulated packet rows
    const packets = [
      { no: "1", time: "0.000", src: "192.168.1.100", dst: "8.8.8.8", proto: "DNS", info: "Standard query A hackthebox.eu" },
      { no: "2", time: "0.012", src: "8.8.8.8", dst: "192.168.1.100", proto: "DNS", info: "Standard query response A 104.26.10.50" },
      { no: "3", time: "0.015", src: "192.168.1.100", dst: "104.26.10.50", proto: "TCP", info: "SYN [SYN] Seq=0 Win=64240" },
      { no: "4", time: "0.028", src: "104.26.10.50", dst: "192.168.1.100", proto: "TCP", info: "SYN-ACK [SYN, ACK] Seq=0 Ack=1" },
      { no: "5", time: "0.029", src: "192.168.1.100", dst: "104.26.10.50", proto: "TLS", info: "Client Hello (TLSv1.3)" },
    ];
    const pktHeaders = ["No.", "Time", "Source", "Destination", "Proto", "Info"];
    const pktWidths = [0.25, 0.4, 1.0, 1.0, 0.45, 1.5];
    // Header row
    let xStart = 0.25;
    pktHeaders.forEach((h, j) => {
      s.addShape(pres.shapes.RECTANGLE, { x: xStart, y: 1.75, w: pktWidths[j], h: 0.22, fill: { color: C.teal, transparency: 60 }, line: { color: C.teal, width: 0.5 } });
      s.addText(h, { x: xStart, y: 1.75, w: pktWidths[j], h: 0.22, fontSize: 7, color: C.white, fontFace: "Consolas", bold: true, align: "center", valign: "middle", margin: 0 });
      xStart += pktWidths[j] + 0.01;
    });

    packets.forEach((pkt, i) => {
      const vals = [pkt.no, pkt.time, pkt.src, pkt.dst, pkt.proto, pkt.info];
      const rowColor = i % 2 === 0 ? "0A1020" : "0D1525";
      const protoColor = pkt.proto === "DNS" ? C.teal : pkt.proto === "TLS" ? C.purple : C.blue2;
      let xc = 0.25;
      vals.forEach((v, j) => {
        s.addShape(pres.shapes.RECTANGLE, { x: xc, y: 2.0 + i * 0.26, w: pktWidths[j], h: 0.24, fill: { color: rowColor }, line: { color: C.gray3, width: 0.3 } });
        s.addText(v, {
          x: xc, y: 2.0 + i * 0.26, w: pktWidths[j], h: 0.24,
          fontSize: 7, color: j === 4 ? protoColor : C.white,
          fontFace: "Consolas", align: j === 5 ? "left" : "center", valign: "middle", margin: 0
        });
        xc += pktWidths[j] + 0.01;
      });
    });

    s.addText("DISPLAY FILTER EXAMPLES:", { x: 0.25, y: 3.37, w: 4.5, h: 0.22, fontSize: 8, color: C.teal, fontFace: "Consolas", bold: true, margin: 0 });
    const filters = [
      "dns                         ← DNS traffic only",
      "tcp.port == 445             ← SMB traffic (red flag!)",
      "ip.addr == 192.168.40.0/28  ← Printer VLAN",
      "http.request.method == POST ← POST requests",
    ];
    filters.forEach((f, i) => {
      s.addShape(pres.shapes.RECTANGLE, { x: 0.25, y: 3.62 + i * 0.33, w: 4.6, h: 0.3, fill: { color: "050D1A" }, line: { color: C.gray3, width: 0.3 } });
      s.addText(f, { x: 0.32, y: 3.62 + i * 0.33, w: 4.5, h: 0.3, fontSize: 8.5, color: C.green, fontFace: "Consolas", valign: "middle", margin: 0 });
    });

    // Nmap section
    s.addShape(pres.shapes.RECTANGLE, { x: 5.1, y: 1.4, w: 4.7, h: 3.85, fill: { color: C.panel }, line: { color: C.orange, width: 1 } });
    s.addShape(pres.shapes.RECTANGLE, { x: 5.1, y: 1.4, w: 4.7, h: 0.3, fill: { color: C.orange, transparency: 70 }, line: { color: C.orange, width: 0 } });
    s.addText("NMAP — NETWORK RECONNAISSANCE", { x: 5.2, y: 1.4, w: 4.5, h: 0.3, fontSize: 9, color: C.orange, fontFace: "Consolas", bold: true, valign: "middle", margin: 0 });

    const nmapCommands = [
      { cmd: "nmap -sn 192.168.1.0/24", desc: "Host discovery — ping sweep\nNo port scan. Find live hosts." },
      { cmd: "nmap -sV -p 22,80,443 10.20.0.1", desc: "Version scan on specific ports\nDetects service & version." },
      { cmd: "nmap -sS -T4 192.168.1.0/24", desc: "Stealth SYN scan (fast)\nHalf-open connections." },
      { cmd: "nmap -sV --script=banner 10.20.0.10", desc: "Banner grabbing via NSE\nGrabs service banners." },
      { cmd: "nmap -A 192.168.1.100", desc: "Aggressive: OS detect + version\n+ scripts + traceroute." },
    ];
    nmapCommands.forEach((nc, i) => {
      s.addShape(pres.shapes.RECTANGLE, { x: 5.15, y: 1.78 + i * 0.68, w: 4.6, h: 0.62, fill: { color: "050D1A" }, line: { color: C.gray3, width: 0.5 } });
      s.addShape(pres.shapes.RECTANGLE, { x: 5.15, y: 1.78 + i * 0.68, w: 0.04, h: 0.62, fill: { color: C.orange }, line: { color: C.orange, width: 0 } });
      s.addText("$ " + nc.cmd, { x: 5.25, y: 1.8 + i * 0.68, w: 4.4, h: 0.25, fontSize: 8.5, color: C.orange, fontFace: "Consolas", margin: 0 });
      s.addText(nc.desc, { x: 5.25, y: 2.04 + i * 0.68, w: 4.4, h: 0.35, fontSize: 8, color: C.gray, fontFace: "Calibri", margin: 0 });
    });
  }

  // ─────────────────────────────────────────────────────────────────
  // SLIDE 14 — KEY TAKEAWAYS & SUMMARY
  // ─────────────────────────────────────────────────────────────────
  {
    const s = pres.addSlide();
    s.background = { color: C.bg };

    // Grid decoration
    for (let i = 0; i < 8; i++) {
      s.addShape(pres.shapes.LINE, { x: i * 1.4, y: 0, w: 0, h: 5.625, line: { color: "1E3A5F", width: 0.5, transparency: 70 } });
    }

    // Bottom cyan bar
    s.addShape(pres.shapes.RECTANGLE, { x: 0, y: 5.3, w: 10, h: 0.325, fill: { color: C.panel }, line: { color: C.panel, width: 0 } });
    s.addShape(pres.shapes.RECTANGLE, { x: 0, y: 5.3, w: 10, h: 0.04, fill: { color: C.cyan }, line: { color: C.cyan, width: 0 } });
    s.addText("HTB ACADEMY  |  Networking Overview  |  Module Complete  |  +10 Points", {
      x: 0.3, y: 5.34, w: 9.4, h: 0.28, fontSize: 8.5, color: C.gray, fontFace: "Consolas", align: "center", charSpacing: 1, margin: 0
    });

    // Title
    s.addText("KEY TAKEAWAYS", { x: 0.3, y: 0.2, w: 9.4, h: 0.55, fontSize: 30, color: C.cyan, fontFace: "Arial Black", bold: true, charSpacing: 3, margin: 0 });
    s.addText("Module 01 — Networking Overview for Cybersecurity", { x: 0.3, y: 0.75, w: 9.4, h: 0.3, fontSize: 11, color: C.gray, fontFace: "Consolas", margin: 0 });

    s.addShape(pres.shapes.LINE, { x: 0.3, y: 1.12, w: 9.4, h: 0, line: { color: C.gray3, width: 1 } });

    // 6 takeaway cards
    const takeaways = [
      { num: "01", title: "Always Verify Subnets", body: "Never assume /24. Use 'ip a' and 'ip route' to confirm your exact subnet before scanning. Missing a /25 split can hide an entire server segment.", color: C.cyan },
      { num: "02", title: "Segment Every Network", body: "Printers, servers, workstations, IP phones, and infrastructure must live in separate VLANs with ACLs between them. Flat networks are fundamentally insecure.", color: C.green },
      { num: "03", title: "DNS is Critical", body: "Every connection starts with DNS. Understand the full resolution chain. Monitor DNS traffic for data exfiltration and C2 communication via DNS tunneling.", color: C.teal },
      { num: "04", title: "Printers Are Attack Surfaces", body: "NTLMv2 relay attacks via printers are real. Block port 445 from printer VLANs. Never connect printers to flat networks or allow internet access.", color: C.red },
      { num: "05", title: "IDS/IPS as a Deterrent", body: "Suricata and Snort detect and block port scans, exploit traffic, and anomalies. Proper placement (inline for IPS) is critical for active protection.", color: C.orange },
      { num: "06", title: "ACLs Are Your Defense Layer", body: "Define explicit PERMIT/DENY rules between segments. Default-deny approach means everything blocked unless explicitly permitted. Audit rules regularly.", color: C.purple },
    ];

    takeaways.forEach((t, i) => {
      const xp = 0.2 + (i % 3) * 3.28;
      const yp = 1.22 + Math.floor(i / 3) * 1.95;
      s.addShape(pres.shapes.RECTANGLE, { x: xp, y: yp, w: 3.1, h: 1.75, fill: { color: C.panel }, line: { color: t.color, width: 1 } });
      s.addShape(pres.shapes.RECTANGLE, { x: xp, y: yp, w: 3.1, h: 0.04, fill: { color: t.color }, line: { color: t.color, width: 0 } });
      // Number badge
      s.addShape(pres.shapes.RECTANGLE, { x: xp + 0.08, y: yp + 0.1, w: 0.38, h: 0.38, fill: { color: t.color, transparency: 30 }, line: { color: t.color, width: 0.5 } });
      s.addText(t.num, { x: xp + 0.08, y: yp + 0.1, w: 0.38, h: 0.38, fontSize: 11, color: C.white, fontFace: "Arial Black", align: "center", valign: "middle", bold: true, margin: 0 });
      s.addText(t.title, { x: xp + 0.55, y: yp + 0.1, w: 2.5, h: 0.38, fontSize: 10, color: t.color, fontFace: "Consolas", bold: true, valign: "middle", margin: 0 });
      s.addShape(pres.shapes.LINE, { x: xp + 0.08, y: yp + 0.55, w: 2.92, h: 0, line: { color: C.gray3, width: 0.5 } });
      s.addText(t.body, { x: xp + 0.08, y: yp + 0.62, w: 2.95, h: 1.05, fontSize: 9, color: C.white, fontFace: "Calibri", margin: 0 });
    });
  }

  // ─────────────────────────────────────────────────────────────────
  // WRITE FILE
  // ─────────────────────────────────────────────────────────────────
  await pres.writeFile({ fileName: "/home/claude/Networking_Overview_CyberSec.pptx" });
  console.log("DONE: Networking_Overview_CyberSec.pptx written.");
}

buildPresentation().catch(console.error);
