    const commands = [
      {
        title: "1. View Network Interfaces & IP Info",
        cmd: "$ ip a\n$ ip addr show eth0\n$ ifconfig  (legacy)",
        output: "2: eth0: <BROADCAST,MULTICAST,UP,LOWER_UP>\n    inet 10.20.0.200/25  brd 10.20.0.255\n    ← SUBNET MASK tells you your network half!",
        color: C.green
      },
      {
        title: "2. Check Routing Table",
        cmd: "$ ip route\n$ ip route show\n$ route -n  (legacy)",
        output: "default via 10.20.0.129 dev eth0\n10.20.0.128/25 dev eth0 proto kernel\n    ← Confirms you're on the .128 half, not .0 half!",
        color: C.cyan
      },
      {
        title: "3. DNS Lookup — dig",
        cmd: "$ dig hackthebox.eu A\n$ dig hackthebox.eu MX\n$ nslookup hackthebox.eu",
        output: ";; ANSWER SECTION:\nhackthebox.eu.  300  IN  A  104.26.10.50\n    ← IP address of the target domain",
        color: C.teal
      },
      {
        title: "4. Network Scanning — Nmap",
        cmd: "$ nmap -sV 192.168.1.0/24\n$ nmap -p 80,443,22 10.20.0.0/25\n$ nmap -sn 192.168.1.0/24  (host discovery)",
        output: "PORT   STATE  SERVICE  VERSION\n22/tcp open   ssh      OpenSSH 8.4\n80/tcp open   http     Apache 2.4.51",
        color: C.orange
      },
